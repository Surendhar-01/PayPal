# MarketTwin Backend Environment Configuration

PROJECT_NAME="MarketTwin API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://10.107.161.106:5173"

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
DEMAND_PERSISTENCE_ENABLED=false
DEMAND_ANALYSIS_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
FRONTEND_URL="http://localhost:5173"

# Groq AI
GROQ_API_KEY="your-groq-api-key"

# AI requirement conversations (Ollama must be reachable from the backend host;
# never expose an unauthenticated port 11434 to the internet)
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:4b"
# Optional bearer token for a protected remote Ollama endpoint.
OLLAMA_API_KEY=""
OLLAMA_HEALTH_TIMEOUT_SECONDS=2

# Buyora product catalogue (server-side only)
BUYORA_CATALOGUE_API_URL="https://buyora-backend-0kae.onrender.com/api/products"
CATALOGUE_API_TIMEOUT_SECONDS=20
CATALOGUE_API_TOTAL_TIMEOUT_SECONDS=24
CATALOGUE_API_MAX_RETRIES=1

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"
